# Copy to .env (never commit .env). All variables are read with the APS_ prefix by the API.
APS_ENV=development                 # development | test | production (production refuses the default JWT secret)
POSTGRES_PASSWORD=aps
APS_DATABASE_URL=postgresql+asyncpg://aps:aps@localhost:5432/aps
APS_REDIS_URL=redis://localhost:6379/0   # optional; rate limiting falls back to in-process
APS_JWT_SECRET=change-me-to-a-long-random-string-of-32+-chars
APS_JWT_TTL_MINUTES=10080
APS_COOKIE_SECURE=false             # true behind HTTPS
APS_CORS_ORIGINS=["http://localhost:3000"]
APS_RATE_LIMIT_PER_MINUTE=240
APS_AUTH_RATE_LIMIT_PER_MINUTE=10
APS_MIN_COHORT_SIZE=30              # percentiles suppressed below this many users
# APS_SANDBOX_URL=                  # isolated code-execution service (not part of this repo yet)
# Web (build time): where Next.js proxies /api
APS_API_ORIGIN=http://localhost:8000
